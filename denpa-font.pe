#!/usr/bin/fontforge
# 自家製 Rounded M+ 1m に和田研中丸ゴシックの字を足す (build.sh から呼ぶ)。
#   fontforge -lang=ff -script denpa-font.pe <元フォントの置き場> <出力 ttf>
# 名前・日付・字の絞り込みはあとの scripts/finish.py がする。

SRC = $1
OUT = $2
MPLUS = SRC + "/rounded-mplus-1m-regular.ttf"
WLCMARU = SRC + "/wlcmaru2004aribu.ttf"
WLCEMOJI = SRC + "/wlcmaru2004emoji.ttf"
COPYLIST = $0:h + "/denpa-font-copylist.txt"

# 和田丸ゴは M+ よりベースラインが高いので下げる
Open(WLCMARU)
SelectWorthOutputting()
Move(0, -120)
Open(WLCEMOJI)
SelectWorthOutputting()
Move(0, -120)

Open(MPLUS)
ScaleToEm(1024)

# Pull up "gjpqy"
SelectSingletons(0x0067, 0xFF47, 0x006A, 0xFF4A, 0x0070, 0xFF50, 0x0071, 0xFF51, 0x0079, 0xFF59)
Scale(100, 90)
Move(0, 45)

copylist = LoadStringFromFile(COPYLIST)
len = Strlen(copylist)
i = 0
ignore = 0
section = 0
uu = 0
while (i < len)
  # UTF-8 to Unicode
  u = Ord(copylist, i++)
  if (u & 0x80)
    u = ((u & 0x3F) * 64) | (Ord(copylist, i++) & 0x3F)
    if (u & 0x800)
      u = ((u & 0x7FF) * 64) | (Ord(copylist, i++) & 0x3F)
      if (u & 0x10000)
        u = ((u & 0xFFFF) * 64) | (Ord(copylist, i++) & 0x3F)
      endif
    endif
  endif
  if (u == 0x23)
    ignore = 1
  elseif (u == 0x0A)
    ignore = 0
  elseif (!ignore)
    if (u == 0x2E)
      section++
    elseif (section == 0 && u != 0x3000)
      SelectSingletons(u)
      DetachAndRemoveGlyphs()
    elseif (section == 1 && u != 0x3000 && !WorthOutputting(u))
      Open(WLCMARU)
      SelectSingletons(u)
      Copy()
      Open(MPLUS)
      SelectSingletons(u)
      Paste()
    elseif (section == 2)
      if (uu)
        if (uu != 0x3000 && u == 0x3000 && !WorthOutputting(uu))
          Open(WLCMARU)
          SelectSingletons(uu)
          Copy()
          Open(MPLUS)
          SelectSingletons(uu)
          Paste()
        elseif (uu != 0x3000 && u != 0x3000 && uu != u && !WorthOutputting(uu))
          SelectSingletons(u)
          CopyReference()
          SelectSingletons(uu)
          Paste()
        endif
        uu = 0
      else
        uu = u
      endif
    elseif (section == 3 && u != 0x3000 && !WorthOutputting(u))
      Open(WLCEMOJI)
      SelectSingletons(u)
      Copy()
      Open(MPLUS)
      SelectSingletons(u)
      Paste()
    endif
  endif
endloop

# 行の高さ (元の Rounded M+ 1m for ARIB と同じ値。上下のダイアクリティカルマークは切れることがある)
SetOS2Value("WinAscentIsOffset", 0)
SetOS2Value("WinDescentIsOffset", 0)
SetOS2Value("HHeadAscentIsOffset", 0)
SetOS2Value("HHeadDescentIsOffset", 0)
SetOS2Value("WinAscent", 981)
SetOS2Value("WinDescent", 168)
SetOS2Value("HHeadAscent", 981)
SetOS2Value("HHeadDescent", -168)
SetOS2Value("TypoLineGap", 0)
SetOS2Value("HHeadLineGap", 0)
Generate(OUT, "", 4)
