{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>5ym/repo-config"
  ],
  "customManagers": [
    {
      "description": "字の一覧を読む denpa の版 (tools/src/repertoire.rs の DENPA_COMMIT)。main の先頭のコミットを追う",
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/src/repertoire\\.rs$/"
      ],
      "matchStrings": [
        "// renovate: datasource=git-refs depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\s+pub const \\w+: &str = \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs"
    }
  ]
}
